# Frontend (optional — leave blank to use the Vite proxy)
# VITE_API_BASE=http://127.0.0.1:8000

# Vite dev-server proxy target (used when VITE_API_BASE is unset)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Clerk publishable key. Leave unset to run guest-only (chats still vanish on refresh).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
