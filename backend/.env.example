# Primary: Google AI Studio (Gemini)
# Either key works; if both are set, GOOGLE_API_KEY takes precedence.
# Get a key at: https://aistudio.google.com/app/api-keys

# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional Gemini model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash

GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# Fallback: Groq (used automatically when Gemini hits rate/quota limits)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# comma-separated CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite path (default: backend/data/jude.db)
# DATABASE_URL=sqlite:///./data/jude.db
